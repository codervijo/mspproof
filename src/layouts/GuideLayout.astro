---
// src/layouts/GuideLayout.astro
//
// Shared chrome for content pages (roundup, /cmmc/ cluster, trust pages):
// head + SEO meta, Organization + BreadcrumbList JSON-LD, header, visible
// breadcrumb, footer. The page supplies its <article> and any extra JSON-LD
// nodes (Article, FAQPage, ...).
import Analytics from "../components/Analytics.astro";
import { site, organizationJsonLd } from "../lib/site";
import "../styles/global.css";
import "../styles/guide.css";

export interface Crumb {
  name: string;
  /** Omit on the current page (last crumb). */
  path?: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  /** Trail after Home; the last entry is the current page. */
  breadcrumbs: Crumb[];
  ogType?: "article" | "website";
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, path, breadcrumbs, ogType = "article", noindex = false, jsonLd = [] } = Astro.props;
const url = `${site.url}${path}`;
const trail: Crumb[] = [{ name: "Home", path: "/" }, ...breadcrumbs];

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    ...jsonLd,
    {
      "@type": "BreadcrumbList",
      itemListElement: trail.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: `${site.url}${c.path ?? path}`,
      })),
    },
    organizationJsonLd(),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (e) {}
      })();
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <header class="border-b border-border">
      <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="text-sm font-semibold tracking-tight text-navy">{site.name}</a>
        <a
          href="/#pilot-form"
          class="rounded-md bg-navy px-3 py-1.5 text-sm font-medium text-navy-foreground hover:opacity-90"
        >Join the MSP pilot</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
      <nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
        {trail.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {c.path && i < trail.length - 1
              ? <a href={c.path} class="hover:text-foreground">{c.name}</a>
              : <span>{c.name}</span>}
          </>
        ))}
      </nav>

      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-8 text-xs text-muted-foreground sm:px-6">
        <p>{site.name} prepares evidence. Certification is granted by authorized C3PAOs and DIBCAC, not by software.</p>
        <nav aria-label="Footer" class="flex gap-4">
          <a href="/privacy/" class="hover:text-foreground">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
