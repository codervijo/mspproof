---
// src/pages/index.astro
import LandingPage from "../components/LandingPage.tsx";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

const site = "https://mspproof.com";
// Trailing slash matches the served URL, the sitemap <loc> and the JSON-LD url
// (trailingSlash: 'always' in astro.config.mjs; CHECK_092 / CHECK_161).
const canonical = `${site}/`;
const title = "MSP Proof — CMMC evidence automation for MSPs";
const description =
  "MSP Proof turns Microsoft 365 and Entra tenant settings into CMMC-ready evidence reports MSPs can white-label for defense contractor clients.";
const ogDescription =
  "Scan Microsoft 365 and Entra, map findings to CMMC / NIST 800-171 controls, generate client-ready evidence packets in hours.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MSP Proof" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />

    <!-- JSON-LD structured data: Organization + WebSite (static; domain
         is known at scaffold time. Update description by hand if needed.) -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mspproof.com/#organization",
      "name": "MSP Proof",
      "url": "https://mspproof.com/"
    },
    {
      "@type": "WebSite",
      "@id": "https://mspproof.com/#website",
      "url": "https://mspproof.com/",
      "name": "MSP Proof",
      "publisher": { "@id": "https://mspproof.com/#organization" }
    }
  ]
}
    </script>

    <!-- Apply persisted theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (e) {}
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <LandingPage client:load />
  </body>
</html>
