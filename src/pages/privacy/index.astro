---
// src/pages/privacy/index.astro
//
// Faceless privacy page (PRD v2.B). Every factual statement is derived from
// the code: LandingPage.tsx pilot form fields, the contact form below,
// Analytics.astro (GA only when PUBLIC_GA_ID is set) and the theme toggle's
// localStorage key. Update this page when any of those change.
//
// Use/no-sale and retention commitments confirmed by the operator 2026-11-07.
// If a new claim needs a [VERIFY] marker, set verifyPending = true and add
// this path to astro.config.mjs's sitemap filter; clear all three together.
import GuideLayout from "../../layouts/GuideLayout.astro";
import { site } from "../../lib/site";

const path = "/privacy/";
const title = `Privacy | ${site.name}`;
const description = `What ${site.name} collects through this website, who processes it, and how to ask for access or deletion.`;
const effective = "2026-10-28";
const verifyPending = false;

const gaEnabled = Boolean(import.meta.env.PUBLIC_GA_ID);
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---
<GuideLayout
  title={title}
  description={description}
  path={path}
  breadcrumbs={[{ name: "Privacy" }]}
  ogType="website"
  noindex={verifyPending}
>
  <article class="guide">
    <h1>Privacy</h1>
    <p class="meta">Effective <time datetime={effective}>October 28, 2026</time>.</p>

    <p class="lede">
      This page covers the {site.name} website. The {site.name} product is pre-launch: nothing on this site
      connects to a Microsoft 365 tenant or collects tenant data.
    </p>

    <h2 id="collect">What we collect</h2>
    <ul>
      <li>
        <strong>Pilot applications.</strong> The pilot form asks for your name, company, work email, number of
        defense contractor clients, whether you manage GCC High tenants, and an optional message.
      </li>
      <li>
        <strong>Privacy requests.</strong> The form on this page asks for your email, the type of request, and a
        message.
      </li>
      {gaEnabled ? (
        <li>
          <strong>Analytics.</strong> This site uses Google Analytics, which sets cookies and records pages viewed,
          referrer, device and approximate location.
        </li>
      ) : (
        <li>
          <strong>No analytics.</strong> This site does not run analytics or advertising trackers.
        </li>
      )}
      <li>
        <strong>Theme preference.</strong> If you switch between light and dark mode, your choice is stored in
        your own browser (local storage). It is not sent to us.
      </li>
    </ul>
    <p>
      The "Email this page" buttons open your own email app with a pre-filled message. We don't see who you
      send it to.
    </p>

    <h2 id="processors">Who processes it</h2>
    <ul>
      <li>
        <strong>Cloudflare</strong> hosts the site and handles standard request data, such as IP address and
        browser type, to deliver pages and block abuse.
      </li>
      <li>
        <strong>Web3Forms</strong> receives form submissions and forwards them to us by email.
      </li>
      {gaEnabled && (
        <li><strong>Google</strong> processes analytics data under its own terms.</li>
      )}
    </ul>

    <h2 id="use">How we use it</h2>
    <p>
      We use form submissions to reply to you and, for pilot applications, to evaluate fit and run the pilot.
      We do not sell personal information or share it for advertising.
    </p>

    <h2 id="retention">Retention and deletion</h2>
    <p>
      We keep submissions only as long as we need them for the purposes above. Ask and we will tell you what we
      hold about you, correct it, or delete it.
    </p>

    <h2 id="contact">Make a request</h2>
    <p>Use this form for access, correction, deletion, or any other privacy question.</p>

    <form id="privacy-form" class="privacy-form" data-key={web3formsKey}>
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        <span>Request</span>
        <select name="request_type" required>
          <option value="access">See what you hold about me</option>
          <option value="correction">Correct my information</option>
          <option value="deletion">Delete my information</option>
          <option value="other">Other question</option>
        </select>
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <button type="submit" class="cta-button">Send request</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <h2 id="changes">Changes</h2>
    <p>If this page changes, the effective date above changes with it.</p>
  </article>
</GuideLayout>

<script>
  // Posts to Web3Forms; shows success only after the service confirms, and
  // errors (never fakes success) when the access key is unset.
  const form = document.getElementById("privacy-form") as HTMLFormElement | null;
  const status = form?.querySelector(".form-status") as HTMLElement | null;
  const button = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !button) return;
    const key = form.dataset.key;
    if (!key) {
      status.textContent = "Requests can't be submitted right now. Please try again later.";
      return;
    }
    const data = new FormData(form);
    data.append("access_key", key);
    data.append("subject", "MSP Proof privacy request");
    data.append("from_name", "MSP Proof privacy form");

    button.disabled = true;
    status.textContent = "Sending…";
    try {
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();
      if (json.success) {
        form.reset();
        status.textContent = "Request received. We'll reply by email.";
      } else {
        status.textContent = json.message || "Something went wrong. Please try again.";
      }
    } catch {
      status.textContent = "Network error. Please try again in a moment.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .privacy-form { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .privacy-form label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.875rem; font-weight: 500; }
  .privacy-form input:not([type="checkbox"]), .privacy-form select, .privacy-form textarea {
    width: 100%; padding: 0.55rem 0.75rem; border: 1px solid var(--color-input); border-radius: calc(var(--radius) - 2px);
    background: var(--color-background); color: var(--color-foreground); font-weight: 400;
  }
  .privacy-form button { align-self: flex-start; border: 0; cursor: pointer; }
  .privacy-form button:disabled { opacity: 0.6; cursor: default; }
  .form-status { font-size: 0.875rem; }
</style>
