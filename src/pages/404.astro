---
// src/pages/404.astro
// Served by Cloudflare for unknown paths (wrangler.jsonc: not_found_handling "404-page").
import "../styles/global.css";

const title = "Page not found — MSP Proof";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <header class="border-b border-border">
      <div class="mx-auto flex h-16 max-w-3xl items-center px-4 sm:px-6">
        <a href="/" class="text-sm font-semibold tracking-tight text-navy">MSP Proof</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
      <p class="font-mono text-xs text-muted-foreground">404</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-navy">This page doesn't exist.</h1>
      <p class="mt-4 text-muted-foreground">
        The link may be old or mistyped. Here's where most people are headed:
      </p>
      <ul class="mt-6 space-y-2 text-sm">
        <li><a href="/" class="underline underline-offset-2 hover:text-navy">MSP Proof home</a></li>
        <li><a href="/guides/best-cmmc-compliance-software/" class="underline underline-offset-2 hover:text-navy">CMMC compliance software for MSPs</a></li>
        <li><a href="/#pilot-form" class="underline underline-offset-2 hover:text-navy">Apply to the MSP pilot</a></li>
      </ul>
    </main>
  </body>
</html>
